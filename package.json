{
  "name": "rail",
  "version": "1.0.0",
  "main": "index.js",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "jail-monkey"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "node ./node_modules/.bin/expo run:ios",
    "android": "node ./node_modules/.bin/expo run:android",
    "android:seeker": "scripts/build-seeker-release-apk.sh",
    "prebuild": "node ./node_modules/.bin/expo prebuild",
    "lint": "NODE_ENV=development node ./node_modules/.bin/eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "NODE_ENV=development node ./node_modules/.bin/eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "test": "NODE_ENV=development node ./node_modules/.bin/jest",
    "test:watch": "NODE_ENV=development node ./node_modules/.bin/jest --watch",
    "test:coverage": "NODE_ENV=development node ./node_modules/.bin/jest --coverage",
    "test:ci": "NODE_ENV=development node ./node_modules/.bin/jest --ci --coverage --maxWorkers=2",
    "web": "expo start --web",
    "docker:build": "docker build -t rail-mobile .",
    "docker:dev": "docker-compose up app-dev",
    "docker:prod": "docker-compose --profile production up",
    "docker:backend": "docker-compose --profile backend up",
    "docker:database": "docker-compose --profile database up postgres",
    "docker:stop": "docker-compose down",
    "docker:clean": "docker-compose down -v && docker system prune -f",
    "setup:dev": "bun install && bun run prepare",
    "clean": "bun run clean:cache && bun run clean:deps",
    "clean:cache": "rm -rf .expo node_modules/.cache",
    "clean:deps": "rm -rf node_modules bun.lockb && bun install",
    "test:docker": "docker-compose exec app-dev bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun run typecheck && bun run lint && bun run test",
    "prepare": "husky",
    "postinstall": "bash scripts/patch-audio.sh"
  },
  "dependencies": {
    "@chainrails/react-native": "0.0.13",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@didit-protocol/sdk-react-native": "3.2.11",
    "@expo/ui": "~55.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react-native": "^1.0.13",
    "@mixpanel/react-native-session-replay": "^1.2.0",
    "@quidone/react-native-wheel-picker": "^1.6.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/drawer": "^7.10.2",
    "@react-navigation/native": "^7.2.4",
    "@rneui/base": "4.0.0-rc.7",
    "@rneui/themed": "4.0.0-rc.8",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.4.18",
    "@solana-mobile/mobile-wallet-adapter-protocol": "^2.2.5",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "^2.2.5",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@speechmatics/expo-two-way-audio": "0.1.2",
    "@tanstack/react-query": "^5.90.5",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "axios": "^1.12.2",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "expo": "^55.0.0",
    "expo-apple-authentication": "~55.0.13",
    "expo-application": "~55.0.15",
    "expo-audio": "~55.0.14",
    "expo-blur": "~55.0.14",
    "expo-camera": "~55.0.18",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-dev-client": "~55.0.33",
    "expo-device": "~55.0.17",
    "expo-file-system": "~55.0.20",
    "expo-font": "~55.0.7",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.14",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-local-authentication": "~55.0.14",
    "expo-localization": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.14",
    "expo-sharing": "~55.0.19",
    "expo-speech": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "expo-system-ui": "~55.0.18",
    "expo-video": "~55.0.17",
    "expo-web-browser": "~55.0.16",
    "jail-monkey": "^2.8.0",
    "mixpanel-react-native": "^3.3.0",
    "moti": "^0.30.0",
    "nativewind": "^4.0.1",
    "phosphor-react-native": "^3.0.6",
    "posthog-react-native": "^4.35.1",
    "posthog-react-native-session-replay": "^1.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-country-flag": "^2.0.2",
    "react-native-css-interop": "^0.2.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "^1.4.74",
    "react-native-gleapsdk": "^15.2.1",
    "react-native-graph": "^1.1.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-live-audio-stream": "^1.1.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-otp-entry": "^1.8.5",
    "react-native-passkey": "3.3.2",
    "react-native-pulsar": "^1.1.0",
    "react-native-qrcode-skia": "^0.3.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screen-transitions": "^3.3.0",
    "react-native-screens": "~4.23.0",
    "react-native-ssl-pinning": "^1.6.0",
    "react-native-svg": "15.15.3",
    "react-native-svg-transformer": "^1.5.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "ws": "^8.16.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.0",
    "@react-native-community/cli": "^20.0.0",
    "@testing-library/react-native": "^12.4.3",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.2",
    "husky": "^9.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.17",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-native-qrcode-styled": "^0.4.0",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.{ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/~/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/~/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|@sentry/react-native|sentry-expo|native-base|react-native-svg|moti|react-native-gifted-charts|gifted-charts-core|react-native-reanimated|@hugeicons/.*|@solana/.*|@solana-mobile/.*)"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/jest.setup.js",
      "!**/~/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    }
  },
  "private": true,
  "overrides": {
    "react-native-webview": "13.16.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/core": "^7.17.4"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ]
}
